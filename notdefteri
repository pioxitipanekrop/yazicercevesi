<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Not Panosu</title>
<style>
body {
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #1e1e2f, #2c2c54);
  color: white;
  margin: 0;
  padding: 20px;
}
.container { max-width: 900px; margin: auto; }
.panel {
  background: #2f2f4f;
  padding: 20px;
  border-radius: 15px;
  box-shadow: 0 0 15px rgba(0,0,0,0.5);
}
textarea {
  width: 100%; height: 120px; border-radius: 10px;
  padding: 10px; border: none; resize: none;
}
button {
  margin-top: 10px; padding: 8px 12px;
  border: none; border-radius: 10px; cursor: pointer;
}
.save { background: #4CAF50; color: white; }
.download { background: #2196F3; color: white; }
.delete { background: #f44336; color: white; margin-left:5px; }
.edit { background: #ff9800; color: white; margin-left:5px; }
.select {
  background: transparent; color: white;
  margin-left:5px; font-size:18px;
}
.selected-dot { color: #9c27b0; }
.notes { margin-top: 20px; }
.note {
  background: #3a3a5f; padding: 10px;
  border-radius: 10px; margin-bottom: 10px;
}
.pagination { margin-top: 15px; }
.pagination button { margin-right: 5px; }
img { max-width: 100%; margin-top: 10px; border-radius: 10px; }
</style>
</head>
<body>
<div class="container">
  <div class="panel">
    <h2>Not Panosu</h2>
    <textarea id="noteInput" placeholder="Notunu yaz..."></textarea><br>
    <input type="file" id="imageInput" accept="image/*"><br>
    <button class="save" onclick="saveNote()">Kaydet</button>
    <button class="download" onclick="downloadSelected()">Seçileni İndir</button>
    <div id="time"></div>
  </div>

  <div class="notes" id="notesContainer"></div>
  <div class="pagination" id="pagination"></div>
</div>

<script>
let notes = JSON.parse(localStorage.getItem("notes")) || [];
let currentPage = 1;
const perPage = 5;
let editIndex = null;
let selectedIndex = null;

function updateTime() {
  document.getElementById("time").innerText = new Date().toLocaleString();
}
setInterval(updateTime, 1000);
updateTime();

function saveToStorage() {
  localStorage.setItem("notes", JSON.stringify(notes));
}

function saveNote() {
  const text = document.getElementById("noteInput").value;
  const file = document.getElementById("imageInput").files[0];

  if (!text && !file) return;

  if (file) {
    const reader = new FileReader();
    reader.onload = function(e) {
      processSave(text, e.target.result);
    };
    reader.readAsDataURL(file);
  } else {
    processSave(text, null);
  }
}

function processSave(text, image) {
  const noteData = {
    text: text,
    image: image,
    date: new Date().toLocaleString()
  };

  if (editIndex !== null) {
    notes[editIndex] = noteData;
    editIndex = null;
  } else {
    notes.unshift(noteData);
  }

  saveToStorage();

  document.getElementById("noteInput").value = "";
  document.getElementById("imageInput").value = "";

  renderNotes();
}

function deleteNote(index) {
  notes.splice(index, 1);
  saveToStorage();
  renderNotes();
}

function editNote(index) {
  document.getElementById("noteInput").value = notes[index].text;
  editIndex = index;
}

function toggleSelect(index) {
  selectedIndex = (selectedIndex === index) ? null : index;
  renderNotes();
}

function renderNotes() {
  const container = document.getElementById("notesContainer");
  container.innerHTML = "";

  const start = (currentPage - 1) * perPage;
  const pageNotes = notes.slice(start, start + perPage);

  pageNotes.forEach((note, i) => {
    const realIndex = start + i;

    const div = document.createElement("div");
    div.className = "note";
    div.innerHTML = `<strong>${note.date}</strong><br><div style="white-space: pre-wrap;">${note.text}</div>`;

    if (note.image) {
      const img = document.createElement("img");
      img.src = note.image;
      div.appendChild(img);
    }

    const selectBtn = document.createElement("button");
    selectBtn.innerText = "•";
    selectBtn.className = "select";
    if (selectedIndex === realIndex) selectBtn.classList.add("selected-dot");
    selectBtn.onclick = () => toggleSelect(realIndex);

    const editBtn = document.createElement("button");
    editBtn.innerText = "Düzenle";
    editBtn.className = "edit";
    editBtn.onclick = () => editNote(realIndex);

    const deleteBtn = document.createElement("button");
    deleteBtn.innerText = "Sil";
    deleteBtn.className = "delete";
    deleteBtn.onclick = () => deleteNote(realIndex);

    div.appendChild(selectBtn);
    div.appendChild(editBtn);
    div.appendChild(deleteBtn);

    container.appendChild(div);
  });

  renderPagination();
}

function renderPagination() {
  const totalPages = Math.ceil(notes.length / perPage);
  const pagination = document.getElementById("pagination");
  pagination.innerHTML = "";

  for (let i = 1; i <= totalPages; i++) {
    const btn = document.createElement("button");
    btn.innerText = i;
    btn.onclick = () => { currentPage = i; renderNotes(); };
    pagination.appendChild(btn);
  }
}

function downloadSelected() {
  if (selectedIndex === null) return alert("Bir not seç!");

  const n = notes[selectedIndex];
  const content = n.date + "\n" + n.text;

  const blob = new Blob([content], { type: "text/plain" });
  const a = document.createElement("a");
  a.href = URL.createObjectURL(blob);
  a.download = "secilen_not.txt";
  a.click();
}

renderNotes();
</script>
</body>
</html>
